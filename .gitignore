cat > .gitignore <<'EOF'
# Virtual environments
.venv/
myenv/
venv/

# Python cache
__pycache__/
*.py[cod]

# Secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# macOS
.DS_Store
EOF
